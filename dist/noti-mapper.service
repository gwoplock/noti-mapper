[Unit]
Description=noti-mapper: latch notification events until acknowledged
Documentation=man:noti-mapper(1) man:noti-mapper.d(5)
After=network-online.target
Wants=network-online.target
# The HomeKit output needs mDNS. If avahi is not installed this ordering is
# simply ignored; it does not make avahi a hard requirement of the service.
After=avahi-daemon.service

[Service]
Type=notify
NotifyAccess=main

# The unit gates on configuration validity so that a typo fails here, loudly,
# rather than after the daemon has already started tearing down the old state.
ExecStartPre=/usr/bin/noti-mapper validate
ExecStart=/usr/bin/noti-mapper run
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=10

# Pinged from the core loop's watchdog thread, which withholds the ping when
# the loop has stopped ticking or an input has been failed for five minutes.
# A live process with a dead IMAP socket is silent, and silence is the one
# failure mode this daemon must not have.
WatchdogSec=120

User=noti-mapper
Group=noti-mapper

# StateDirectory creates /var/lib/noti-mapper with the right ownership and
# exports $STATE_DIRECTORY, which is why this is here rather than a tmpfiles
# rule. Not DynamicUser: persistent state and stable file ownership rule it out.
StateDirectory=noti-mapper
StateDirectoryMode=0750
ConfigurationDirectory=noti-mapper.d
ConfigurationDirectoryMode=0755

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

# Deliberately absent, and not an oversight:
#
#   PrivateNetwork=yes           would cut off IMAP, PagerDuty, and mDNS.
#   RestrictAddressFamilies=...  HAP-python's zeroconf layer needs AF_INET and
#                                AF_INET6 multicast on the same L2 segment as
#                                the Apple Home hub. Narrowing address families
#                                here breaks HomeKit pairing in a way that is
#                                very hard to diagnose from the symptom.
#
# Users whose IoT devices live on a separate VLAN need an mDNS reflector; no
# amount of unit hardening changes that.

[Install]
WantedBy=multi-user.target
